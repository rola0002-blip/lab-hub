# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vitest/
/.vitest-reports/

# backups (scripts/backup.sh output)
/backups/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers
.superpowers/
.env
data/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# SDD per-plan workspaces (scratch — briefs, reports, review packages)
.sdd/

# local installer smoke-test installs
.smoke-labhub/

# Internal dev narratives stay out of the public repo (SP10 flip decision):
# specs/plans/handoffs are written locally under docs/superpowers/ and docs/handoffs/,
# and CLAUDE.md is a local-only agent-conventions file. Pre-flip history lives in the
# dated archive under ~/Documents/Systems/.
CLAUDE.md
docs/superpowers/
docs/handoffs/

# Tauri desktop shell (SP11) — build artifacts and generated schemas
/desktop/src-tauri/target/
/desktop/src-tauri/gen/

# Local git worktrees
.worktrees/
.playwright-mcp/
