generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- better-auth managed (verify with: npx @better-auth/cli generate) ----------
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("guest") // 'admin' | 'member' | 'guest'
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  themePreference String? // 'light' | 'dark' — per-user theme, applied SSR when device localStorage is empty
  accentPreference String? // accent slug (src/lib/accents.ts); applied SSR when device localStorage is empty
  title            String? // free-text role/title, ≤100 chars, shown under the name on People
  timezone         String? // IANA tz id; drives the member's local time on People
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  bookings       Booking[]          @relation("BookingUser")
  certifications Certification[]    @relation("CertUser")
  managed        EquipmentManager[]
  notifications  Notification[]

  chatMemberships   ConversationMember[]
  chatMessages      Message[]            @relation("ChatAuthor")
  chatReactions     Reaction[]
  pushSubscriptions PushSubscription[]

  projectsLed     Project[]         @relation("ProjectLead")
  issuesCreated   Issue[]           @relation("IssueCreator")
  issuesAssigned  Issue[]           @relation("IssueAssignee")
  issueComments   IssueComment[]
  issueUploads    IssueAttachment[]
  issueActivities IssueActivity[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------- LabHub domain ----------
model Organization {
  id            String  @id @default(cuid())
  name          String
  logoPath      String?
  accentColor   String  @default("#0d9488")
  timezone      String  @default("Asia/Singapore")
  setupComplete Boolean @default(false)
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  role        String // 'admin' | 'member' | 'guest'
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  invitedById String
  createdAt   DateTime         @default(now())
}

enum EquipmentStatus {
  ACTIVE
  RETIRED
}

enum ApprovalPolicy {
  NONE
  GUESTS
  ALL
}

model Equipment {
  id                    String          @id @default(cuid())
  name                  String
  description           String          @default("")
  location              String          @default("")
  photoPath             String?
  status                EquipmentStatus @default(ACTIVE)
  advanceBookingDays    Int             @default(14)
  maxDurationMinutes    Int             @default(480)
  certificationRequired Boolean         @default(false)
  approvalPolicy        ApprovalPolicy  @default(GUESTS)
  allowRecurring        Boolean         @default(false)
  createdAt             DateTime        @default(now())

  bookings       Booking[]
  certifications Certification[]
  managers       EquipmentManager[]
  maintenance    MaintenanceWindow[]
  recurrences    RecurrenceRule[]
}

model Certification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("CertUser", fields: [userId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  grantedById String
  grantedAt   DateTime  @default(now())

  @@unique([userId, equipmentId])
}

model EquipmentManager {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([userId, equipmentId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
}

model Booking {
  id               String          @id @default(cuid())
  equipmentId      String
  equipment        Equipment       @relation(fields: [equipmentId], references: [id])
  userId           String
  user             User            @relation("BookingUser", fields: [userId], references: [id])
  startsAt         DateTime        @db.Timestamptz
  endsAt           DateTime        @db.Timestamptz
  purpose          String          @default("")
  status           BookingStatus   @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  rejectionReason  String?
  recurrenceRuleId String?
  recurrenceRule   RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id])
  reminderSentAt   DateTime?
  createdAt        DateTime        @default(now())

  @@index([equipmentId, startsAt])
  @@index([userId, startsAt])
  @@index([status, startsAt])
}

model RecurrenceRule {
  id              String    @id @default(cuid())
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id])
  userId          String
  daysOfWeek      Int[] // 0=Sunday .. 6=Saturday
  startMinutes    Int // minutes from midnight, org timezone
  durationMinutes Int
  firstDate       String // 'yyyy-MM-dd' in org timezone
  untilDate       String // 'yyyy-MM-dd' inclusive
  createdAt       DateTime  @default(now())

  bookings Booking[]
}

model MaintenanceWindow {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  reason      String
  createdById String
  createdAt   DateTime  @default(now())

  @@index([equipmentId, startsAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model EmailOutbox {
  id            String      @id @default(cuid())
  toEmail       String
  subject       String
  html          String
  status        EmailStatus @default(QUEUED)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([status, nextAttemptAt])
}

// ---------- Messaging (sub-project 2) ----------
enum ConversationType {
  CHANNEL
  DM
}

model Conversation {
  id             String           @id @default(cuid())
  type           ConversationType
  name           String?
  topic          String           @default("")
  isPrivate      Boolean          @default(false)
  createdById    String
  archivedAt     DateTime?
  slackChannelId String?          @unique
  dmKey          String?          @unique
  createdAt      DateTime         @default(now())

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  muted          Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String                   @id @default(cuid())
  conversationId  String
  conversation    Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User                     @relation("ChatAuthor", fields: [userId], references: [id])
  body            String
  kind            String                   @default("user") // 'user' | 'system' — system rows are event lines, never counted unread / never notified
  parentId        String?
  parent          Message?                 @relation("Thread", fields: [parentId], references: [id])
  replies         Message[]                @relation("Thread")
  mentionUserIds  String[]
  mentionsChannel Boolean                  @default(false)
  editedAt        DateTime?
  deletedAt       DateTime?
  slackTs         String?
  createdAt       DateTime                 @default(now())
  search          Unsupported("tsvector")?

  reactions   Reaction[]
  attachments ChatAttachment[]

  originatedIssues Issue[] @relation("IssueOrigin")

  @@unique([conversationId, slackTs])
  @@index([conversationId, createdAt])
  @@index([parentId])
}

model Reaction {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  @@unique([messageId, userId, emoji])
}

model ChatAttachment {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  path      String
  name      String
  mime      String
  size      Int
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ---------- Project management (sub-project 4) ----------
enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELED
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum IssuePriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String        @default("")
  leadId      String?
  lead        User?         @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  startDate   DateTime?
  targetDate  DateTime?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  issues Issue[]
}

model Issue {
  id              String                   @id @default(cuid())
  // Drawn from the workspace-global issue_number_seq (created in the migration).
  // dbgenerated → Prisma omits it on insert; Postgres nextval fills it atomically
  // so concurrent creates never collide. Rendered as COL-<number>.
  number          Int                      @unique @default(dbgenerated("nextval('issue_number_seq'::regclass)"))
  title           String
  description     String                   @default("")
  status          IssueStatus              @default(BACKLOG)
  priority        IssuePriority            @default(NONE)
  assigneeId      String?
  assignee        User?                    @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId       String
  creator         User                     @relation("IssueCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  projectId       String?
  project         Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  dueDate         DateTime?
  // Fractional-index ordering key within a board column. COLLATE "C" (set in the
  // migration) so Postgres orders it by byte = base-62 order (rank.ts).
  rank            String
  completedAt     DateTime?
  // Backlink for create-from-message. SetNull: deleting the source message never
  // deletes the issue.
  originMessageId String?
  originMessage   Message?                 @relation("IssueOrigin", fields: [originMessageId], references: [id], onDelete: SetNull)
  search          Unsupported("tsvector")?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  labels      IssueLabel[]
  comments    IssueComment[]
  attachments IssueAttachment[]
  activities  IssueActivity[]

  @@index([status, rank])
  @@index([projectId])
  @@index([assigneeId])
}

model Label {
  id    String @id @default(cuid())
  name  String @unique
  color String

  issues IssueLabel[]
}

model IssueLabel {
  id      String @id @default(cuid())
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
}

model IssueComment {
  id             String    @id @default(cuid())
  issueId        String
  issue          Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body           String
  mentionUserIds String[]
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([issueId, createdAt])
}

model IssueAttachment {
  id         String @id @default(cuid())
  issueId    String
  issue      Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  path       String
  name       String
  mime       String
  size       Int

  @@index([issueId])
}

model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  // 'created' | 'status' | 'assignee' | 'priority' | 'project' | 'due_date' | 'labels' | 'title'
  type      String
  data      Json
  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}
