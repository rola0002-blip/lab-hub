generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- better-auth managed (verify with: npx @better-auth/cli generate) ----------
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("guest") // 'admin' | 'member' | 'guest'
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  themePreference String? // 'light' | 'dark' — per-user theme, applied SSR when device localStorage is empty
  accentPreference String? // accent slug (src/lib/accents.ts); applied SSR when device localStorage is empty
  title            String? // free-text role/title, ≤100 chars, shown under the name on People
  timezone         String? // IANA tz id; drives the member's local time on People
  isSystem         Boolean   @default(false) // true ONLY for the LabHub Bot; excluded from every human enumeration (SP5 §5.6)
  icsToken         String?   @unique // per-user calendar-feed token; nullable-unique (many NULLs coexist), minted lazily (SP5 §4.1)
  // v0.16 F3/F7/F9 + v0.23 D6: per-user workspace state. pinnedProjectIds is pin order
  // (NOT NULL array, SQL DEFAULT '{}' — a rolled-back binary INSERTs fine);
  // lastConversationId is a plain string (membership re-validated at read, NOT
  // a FK — DMs/channels are never hard-deleted and stale degrades to fallback);
  // soundsEnabled default ON since v0.23 (wave-9 migration flipped the column
  // default + all existing rows; per-device localStorage 'sounds'='0' still wins).
  pinnedProjectIds   String[]  @default([])
  lastConversationId String?
  soundsEnabled      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  bookings       Booking[]          @relation("BookingUser")
  certifications Certification[]    @relation("CertUser")
  managed        EquipmentManager[]
  notifications  Notification[]

  chatMemberships   ConversationMember[]
  chatMessages      Message[]            @relation("ChatAuthor")
  chatReactions     Reaction[]
  pushSubscriptions PushSubscription[]

  projectsLed     Project[]         @relation("ProjectLead")
  projectUpdates  ProjectUpdate[]
  issuesCreated   Issue[]           @relation("IssueCreator")
  issuesAssigned  Issue[]           @relation("IssueAssignee")
  issueComments   IssueComment[]
  issueUploads    IssueAttachment[]
  issueActivities IssueActivity[]

  documents       Document[]
  documentFolders DocumentFolder[]

  feedback Feedback[]
  raAcknowledgments RaAcknowledgment[]
  trainings          TrainingRecord[] @relation("TrainingUser")
  trainingsAsTrainer TrainingRecord[] @relation("TrainingTrainer")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------- LabHub domain ----------
model Organization {
  id               String  @id @default(cuid())
  name             String
  logoPath         String?
  accentColor      String  @default("#0d9488")
  timezone         String  @default("Asia/Singapore")
  // SP8: org-level weekly update-prompt cadence (0=Sunday, matching Date.getDay()).
  // NOT NULL DEFAULT so no read site re-decides a fallback (spec §4.0).
  updatePromptDay  Int     @default(2)
  updatePromptHour Int     @default(16)
  setupComplete    Boolean @default(false)
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  role        String // 'admin' | 'member' | 'guest'
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  invitedById String
  createdAt   DateTime         @default(now())
}

enum EquipmentStatus {
  ACTIVE
  RETIRED
}

enum ApprovalPolicy {
  NONE
  GUESTS
  ALL
}

model Equipment {
  id                    String          @id @default(cuid())
  name                  String
  description           String          @default("")
  location              String          @default("")
  photoPath             String?
  status                EquipmentStatus @default(ACTIVE)
  advanceBookingDays    Int             @default(14)
  maxDurationMinutes    Int             @default(480)
  certificationRequired Boolean         @default(false)
  approvalPolicy        ApprovalPolicy  @default(GUESTS)
  allowRecurring        Boolean         @default(false)
  createdAt             DateTime        @default(now())

  bookings       Booking[]
  certifications Certification[]
  trainings TrainingRecord[]
  managers       EquipmentManager[]
  maintenance    MaintenanceWindow[]
  recurrences    RecurrenceRule[]
}

model Certification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("CertUser", fields: [userId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  grantedById String
  grantedAt   DateTime  @default(now())

  @@unique([userId, equipmentId])
}

model EquipmentManager {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([userId, equipmentId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
}

model Booking {
  id               String          @id @default(cuid())
  equipmentId      String
  equipment        Equipment       @relation(fields: [equipmentId], references: [id])
  userId           String
  user             User            @relation("BookingUser", fields: [userId], references: [id])
  startsAt         DateTime        @db.Timestamptz
  endsAt           DateTime        @db.Timestamptz
  purpose          String          @default("")
  status           BookingStatus   @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  rejectionReason  String?
  recurrenceRuleId String?
  recurrenceRule   RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id])
  reminderSentAt   DateTime?
  sessionStartedAt DateTime?
  sessionEndedAt   DateTime?
  sessionNote      String    @default("")
  createdAt        DateTime  @default(now())

  @@index([equipmentId, startsAt])
  @@index([userId, startsAt])
  @@index([status, startsAt])
}

model RecurrenceRule {
  id              String    @id @default(cuid())
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id])
  userId          String
  daysOfWeek      Int[] // 0=Sunday .. 6=Saturday
  startMinutes    Int // minutes from midnight, org timezone
  durationMinutes Int
  firstDate       String // 'yyyy-MM-dd' in org timezone
  untilDate       String // 'yyyy-MM-dd' inclusive
  createdAt       DateTime  @default(now())

  bookings Booking[]
}

model MaintenanceWindow {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  reason      String
  createdById String
  createdAt   DateTime  @default(now())

  @@index([equipmentId, startsAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  readAt    DateTime?
  // v0.16 F8: stamped when this bell row has been emailed (immediately by
  // notify() when an email rides along, or by the 60-min digest job). Null =
  // never emailed. Single source of truth against double-emailing.
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model EmailOutbox {
  id            String      @id @default(cuid())
  toEmail       String
  subject       String
  html          String
  status        EmailStatus @default(QUEUED)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([status, nextAttemptAt])
}

// ---------- Messaging (sub-project 2) ----------
enum ConversationType {
  CHANNEL
  DM
}

model Conversation {
  id             String           @id @default(cuid())
  type           ConversationType
  name           String?
  topic          String           @default("")
  isPrivate      Boolean          @default(false)
  createdById    String
  archivedAt     DateTime?
  slackChannelId String?          @unique
  dmKey          String?          @unique
  createdAt      DateTime         @default(now())

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  muted          Boolean      @default(false)
  // v0.17 W4-A2: per-user favorite (rail sorts favorites first within each
  // section). Named favorite, NOT pinned, to avoid colliding with
  // pinnedProjectIds/pinnedAt concepts.
  favorite       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String                   @id @default(cuid())
  conversationId  String
  conversation    Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User                     @relation("ChatAuthor", fields: [userId], references: [id])
  body            String
  kind            String                   @default("user") // 'user' | 'system' — system rows are event lines, never counted unread / never notified
  parentId        String?
  parent          Message?                 @relation("Thread", fields: [parentId], references: [id])
  replies         Message[]                @relation("Thread")
  mentionUserIds  String[]
  mentionsChannel Boolean                  @default(false)
  editedAt        DateTime?
  // v0.17 W4-A1: set when pinned (members/admins only, header popover surface);
  // null = unpinned. No index — the pinned list scans one conversation via the
  // existing @@index([conversationId, createdAt]) at lab scale.
  pinnedAt        DateTime?
  deletedAt       DateTime?
  slackTs         String?
  createdAt       DateTime                 @default(now())
  search          Unsupported("tsvector")?

  reactions   Reaction[]
  attachments ChatAttachment[]

  originatedIssues         Issue[]         @relation("IssueOrigin")
  originatedProjectUpdates ProjectUpdate[] @relation("ProjectUpdateOrigin")

  @@unique([conversationId, slackTs])
  @@index([conversationId, createdAt])
  @@index([parentId])
}

model Reaction {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  @@unique([messageId, userId, emoji])
}

model ChatAttachment {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  path      String
  name      String
  mime      String
  size      Int
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ---------- Project management (sub-project 4) ----------
enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELED
}

// SP8: three stored health values; the fourth visible state ("No update") is DERIVED
// (no update, or latest older than STALE_PROJECT_DAYS) — storing it would require a
// write to express silence (spec §4.1).
enum ProjectHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum IssuePriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id                       String          @id @default(cuid())
  name                     String
  description              String          @default("")
  leadId                   String?
  lead                     User?           @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  startDate                DateTime?
  targetDate               DateTime?
  status                   ProjectStatus   @default(ACTIVE)
  // Fractional-index arrangement key for the /projects grid. COLLATE "C" (set in
  // the migration) so Postgres orders it by byte = base-62 order (rank.ts).
  // Lowest key = front. One sequence across all statuses; the closed grid ignores it.
  // No @default here on purpose — the app always mints; the SQL-only DEFAULT 'zz' the
  // migration sets exists solely so a rolled-back pre-0.12 binary can still INSERT.
  rank                     String
  // SP8: recurring prompt latch — compared to the CURRENT week's promptAt, not the
  // one-shot dueSoonPingedAt idiom (which would fire once per project, ever).
  lastUpdatePromptAt       DateTime?
  // SP8: snooze — anchored to a prompt instant + 1ms (update-prompt.ts nthPromptAfter),
  // never a rolling 7 days. null = not paused.
  updatePromptsPausedUntil DateTime?
  // v0.15: the Files folder backing this project. Nullable, NOT unique — one shared
  // folder may back several projects; deleting it detaches them (SetNull).
  documentFolderId         String?
  documentFolder           DocumentFolder? @relation(fields: [documentFolderId], references: [id], onDelete: SetNull)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  issues         Issue[]
  projectUpdates ProjectUpdate[]
  milestones     Milestone[] // v0.16 F4 (dates + progress only; never linked to issues)
  labels         Label[] // v0.16 F5 back-relation (Label.projectId; partial uniques live in SQL only)

  @@index([status])
  @@index([leadId])
  @@index([rank])
  @@index([documentFolderId])
}

model ProjectUpdate {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Restrict, deliberately unlike Document.uploaderId's Cascade: the update is the
  // wave's one durable record (annual reports, committee meetings). Users are banned,
  // never deleted, so this FK never fires; if a hard delete is ever added it must
  // fail loudly rather than silently erase the lab's narrative history (spec §4.1).
  authorId        String
  author          User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  health          ProjectHealth
  body            String // ≤ 4000, enforced in project-update-service
  originMessageId String?
  originMessage   Message?      @relation("ProjectUpdateOrigin", fields: [originMessageId], references: [id], onDelete: SetNull)
  // v0.15 §6.1: author edit + soft delete, the Message/IssueComment shape. The
  // tombstone keeps the row (feed history is never erased) and blanks the body;
  // every "latest update" read filters deletedAt: null.
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())

  attachments ProjectUpdateAttachment[] // v0.16 F6 — the ChatAttachment pattern

  @@index([projectId, createdAt])
}

// v0.16 F4: a dated milestone on a project. date is an org-tz yyyy-MM-dd string
// (the RecurrenceRule firstDate/untilDate convention — day-granular, no tz
// ambiguity; lexicographic compare works). completedAt null = open. Manual
// completion only — issues are NEVER linked to milestones (spec decision).
model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String // 1–200, enforced in project-service
  date        String? // org-tz yyyy-MM-dd or null
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}

// v0.16 F6: a file attached to a project update — byte-for-byte the
// ChatAttachment pattern (path/name/mime/size tuple; server-minted
// /uploads/project-updates/<uuid><ext> path; human name capped 200 at write).
model ProjectUpdateAttachment {
  id        String        @id @default(cuid())
  updateId  String
  update    ProjectUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  path      String
  name      String
  mime      String
  size      Int
  createdAt DateTime      @default(now())

  @@index([updateId])
}

model Issue {
  id              String                   @id @default(cuid())
  // Drawn from the workspace-global issue_number_seq (created in the migration).
  // dbgenerated → Prisma omits it on insert; Postgres nextval fills it atomically
  // so concurrent creates never collide. Rendered as COL-<number>.
  number          Int                      @unique @default(dbgenerated("nextval('issue_number_seq'::regclass)"))
  title           String
  description     String                   @default("")
  status          IssueStatus              @default(BACKLOG)
  priority        IssuePriority            @default(NONE)
  assigneeId      String?
  assignee        User?                    @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId       String
  creator         User                     @relation("IssueCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  projectId       String?
  project         Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  dueDate         DateTime?
  // Fractional-index ordering key within a board column. COLLATE "C" (set in the
  // migration) so Postgres orders it by byte = base-62 order (rank.ts).
  rank            String
  completedAt     DateTime?
  dueSoonPingedAt DateTime?                // set when the due-soon bot DM fires; cleared when dueDate changes (re-arms) (SP5 §5.7)
  overduePingedAt DateTime?                // set when the overdue bot DM fires; cleared when dueDate changes (re-arms) (v0.9.5)
  // Backlink for create-from-message. SetNull: deleting the source message never
  // deletes the issue.
  originMessageId String?
  originMessage   Message?                 @relation("IssueOrigin", fields: [originMessageId], references: [id], onDelete: SetNull)
  search          Unsupported("tsvector")?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  labels      IssueLabel[]
  comments    IssueComment[]
  attachments IssueAttachment[]
  activities  IssueActivity[]

  @@index([status, rank])
  @@index([projectId])
  @@index([assigneeId])
}

model Label {
  id        String   @id @default(cuid())
  // v0.16 F5: null = workspace-global. Uniqueness is TWO partial indexes that
  // live in the migration SQL only (Prisma cannot express them — the booking
  // exclusion-constraint posture): (name) WHERE "projectId" IS NULL and
  // (name, "projectId") WHERE "projectId" IS NOT NULL. Never reintroduce
  // @unique on name — it would fight the partial indexes.
  name      String
  color     String
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  issues IssueLabel[]

  @@index([projectId])
}

model IssueLabel {
  id      String @id @default(cuid())
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
}

model IssueComment {
  id             String    @id @default(cuid())
  issueId        String
  issue          Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body           String
  mentionUserIds String[]
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([issueId, createdAt])
}

model IssueAttachment {
  id         String @id @default(cuid())
  issueId    String
  issue      Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  path       String
  name       String
  mime       String
  size       Int

  @@index([issueId])
}

model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  // 'created' | 'status' | 'assignee' | 'priority' | 'project' | 'due_date' | 'labels' | 'title'
  type      String
  data      Json
  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}

// ---------- Files: shared document library (sub-project 5, sub-feature D) ----------
model DocumentFolder {
  id          String   @id @default(cuid())
  name        String   @unique // folder names are unique across the single level
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  documents Document[]
  projects  Project[] // v0.15: back-relation for Project.documentFolderId (no unique — a folder may back several)
}

model Document {
  id         String                   @id @default(cuid())
  folderId   String? // null = root
  folder     DocumentFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name       String // original filename, capped at 200 chars on write
  path       String // served /uploads/documents/<uuid>.<ext>
  mime       String
  size       Int
  uploaderId String
  uploader   User                     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  // Generated tsvector over `name`; the GIN index lives in the migration SQL only
  // (like Issue.search) — this is what keeps the migration hand-written.
  search     Unsupported("tsvector")?
  createdAt  DateTime                 @default(now())

  @@index([folderId])
}

// ---------- Feedback: in-app bug reports and ideas (v0.13) ----------
enum FeedbackType {
  BUG
  IDEA
}

enum FeedbackStatus {
  NEW
  REVIEWED
  PLANNED
  DONE
  DECLINED
}

model Feedback {
  id             String         @id @default(cuid())
  type           FeedbackType
  status         FeedbackStatus @default(NEW)
  body           String
  screenshotPath String?
  // Stamped server-side at submit so a report always carries the build and the
  // page it came from; the client never supplies appVersion/userAgent.
  appVersion     String
  pagePath       String
  userAgent      String
  authorId       String
  // Restrict, like Issue.creatorId / ProjectUpdate.authorId: a report is part of
  // the record and must fail loudly rather than be silently erased. (Users are
  // banned, never deleted, so this FK never fires today.)
  author         User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  // Doubles as "when the status last changed" — no separate decidedAt column.
  updatedAt      DateTime       @updatedAt

  // No tsvector `search` column, unlike Issue/Document: the queue is filtered by
  // status, not searched.
  @@index([status, createdAt])
  @@index([authorId, createdAt])
}

// ---------- RA acknowledgments: risk-assessment read receipts (v0.23 / wave 9) ----------
model RaAcknowledgment {
  id           String   @id @default(cuid())
  userId       String
  // Restrict like Feedback.authorId: the lab's compliance record must fail
  // loudly, never silently erase. (Users are banned, never deleted.)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  // PLAIN STRING, deliberately NOT an FK, + a name snapshot: deleting an RA
  // from Files must never destroy (or be blocked by) the evidence that it was
  // read — the User.lastConversationId non-FK posture.
  documentId   String
  documentName String
  matricNumber String
  createdAt    DateTime @default(now())

  @@unique([userId, documentId])
  @@index([createdAt])
}

// v0.26 W12-B: append-only training log. One row per NEW certification grant (a
// re-check of an existing cert is a no-op; revoke → re-grant appends). trainedOn is
// an org-tz yyyy-MM-dd string (the Milestone.date convention). People RESTRICT (the
// RaAcknowledgment posture), equipment CASCADEs (the Certification posture).
model TrainingRecord {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("TrainingUser", fields: [userId], references: [id], onDelete: Restrict)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  trainedById String
  trainedBy   User      @relation("TrainingTrainer", fields: [trainedById], references: [id], onDelete: Restrict)
  trainedOn   String // org-tz yyyy-MM-dd
  note        String    @default("") // ≤500, enforced in the action
  createdAt   DateTime  @default(now())

  @@index([userId, equipmentId])
  @@index([equipmentId])
}
