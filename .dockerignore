# Keep the build context lean and prevent host-arch artifacts from leaking in
# via `COPY . .` (deps are reinstalled cleanly in the `deps` stage).
node_modules
.next
.git
.vitest
data
backups
*.log
.env
.env.*
!.env.example
coverage
playwright-report
test-results
# desktop/ is the Tauri shell — never part of the web image. Also keeps cargo's
# multi-GB desktop/src-tauri/target out of the context (a bare 'debug' pattern
# would only match the context ROOT, not nested target dirs).
desktop
