# --- Database ---
DATABASE_URL=postgresql://labhub:labhub@localhost:5432/labhub
POSTGRES_PASSWORD=labhub          # used by docker compose; match DATABASE_URL
# Host-side db publish port (compose binds 127.0.0.1:${DB_PORT}:5432). Default 5432. On a shared
# host where 5432 is already taken (e.g. another compose project), set a free port here so the
# fresh clone's db container doesn't collide. The app reaches Postgres over the compose network
# at db:5432 regardless — this only affects on-box psql/tools and the health-poll workflow.
DB_PORT=5432

# --- App (internet-facing via the Cloudflare tunnel) ---
# APP_URL must equal EXACTLY the public Cloudflare hostname: scheme + host, https, no trailing
# slash, no path, no port. It is the single source of truth for every emitted URL, better-auth
# baseURL, Secure-cookie enablement, and Origin/CSRF checks — a mismatch 403s sign-in.
APP_URL=https://labhub.example.com
# Loopback health-poll port ONLY (compose binds 127.0.0.1:${APP_PORT}:3000). NOT the public
# ingress port — the tunnel serves the public hostname. Leave at 3000 on the tunnel host.
APP_PORT=3000
BETTER_AUTH_SECRET=change-me-32-chars-minimum-random  # REQUIRED, min 32 chars: openssl rand -hex 32
UPLOADS_DIR=./data/uploads        # /data/uploads inside the app container

# --- SMTP (any provider). Leave blank: emails stay QUEUED in the outbox; invites use copy-links ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LabHub <no-reply@example.com>

# --- Web Push (REQUIRED on an HTTPS host — must be MINTED, not left blank) ---
# Under the tunnel push is a live deliverable: blank keys ⇒ pushEnabled() false ⇒ the opt-in
# silently aborts. Mint once: npx web-push generate-vapid-keys  (init-env.sh does this for you).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Auth rate limiting (behind the tunnel = genuinely per-client) ---
# CF-Connecting-IP is the single, Cloudflare-set, unspoofable client IP. Setting
# AUTH_TRUSTED_IP_HEADER=cf-connecting-ip makes better-auth read ONLY that header, so the
# sign-in/up limiter is per-client and session IP logging is correct — no trustedProxies needed.
# With genuine per-client limiting, the code default of 10/60s is correct (the SP6 LAN value of
# 100 was a shared-bucket workaround and is retired). Password reset stays fixed at 5/300s.
AUTH_TRUSTED_IP_HEADER=cf-connecting-ip
AUTH_RATE_LIMIT_MAX=10

# --- Setup bootstrap gate (optional; recommended on an internet-facing host) ---
# When set, the setup wizard requires this exact token before creating the first admin, so an
# un-invited party cannot seize workspace admin over the public tunnel before setup completes.
# init-env.sh mints one and prints it. Leave blank/unset for local dev (gate disabled).
SETUP_TOKEN=

# --- Cloudflare Tunnel ---
# The connector token for the `tunnel` compose profile. Per-deployment: created in the
# Cloudflare Zero Trust dashboard (see docs/ops/macos-server.md) and written by init-env.sh.
# TUNNEL_TOKEN=

# --- Jobs / misc ---
DISABLE_JOBS=                     # set to 1 in tests
