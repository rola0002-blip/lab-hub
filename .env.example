# --- Database ---
DATABASE_URL=postgresql://labhub:labhub@localhost:5432/labhub
POSTGRES_PASSWORD=labhub          # used by docker compose; match DATABASE_URL

# --- App ---
APP_URL=http://localhost:3000     # public URL (e.g. https://hub.tay-labs.com in prod)
APP_PORT=3000                     # host port compose maps to the app (set 80 on the LAN server for clean http://<host>/)
BETTER_AUTH_SECRET=change-me-32-chars-minimum-random  # REQUIRED, min 32 chars: openssl rand -hex 32
UPLOADS_DIR=./data/uploads        # /data/uploads inside the app container

# --- SMTP (any provider). Leave blank in dev: emails stay QUEUED in the outbox ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=COLOSSUS <no-reply@example.com>

# --- Web Push (optional; blank = push disabled). Generate once: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Auth rate limiting ---
# Max sign-in + sign-up attempts per 60s in better-auth's per-IP limiter. Behind the LAN
# beta's directly-published Docker port every client shares ONE gateway IP, so this bucket
# is lab-wide (not per-user): at 10 an onboarding burst, or one user mistyping a password,
# can 429 sign-in for everyone. Raise it on a trusted LAN (e.g. 100) — per-IP identity is
# meaningless behind the published port and invitation-only sign-up bounds the surface.
# The limiter stays ON; this only tunes the ceiling. Default 10 (dev/CI). Password reset
# keeps its own fixed 5/300s bucket.
AUTH_RATE_LIMIT_MAX=10

# --- Jobs / misc ---
DISABLE_JOBS=                     # set to 1 in tests
# TUNNEL_TOKEN=                   # Cloudflare Tunnel token (enables the "tunnel" compose profile)
